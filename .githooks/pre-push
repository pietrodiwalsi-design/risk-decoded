#!/usr/bin/env bash
# Block pushes that contain secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-push] running gitleaks…"
  gitleaks protect --staged --redact --verbose || {
    echo "[pre-push] BLOCKED: potential secret detected. Fix before pushing." >&2
    exit 1
  }
  echo "[pre-push] gitleaks clean."
else
  echo "[pre-push] WARNING: gitleaks not installed — install it to enforce secret scanning." >&2
  echo "[pre-push] https://github.com/gitleaks/gitleaks" >&2
fi
