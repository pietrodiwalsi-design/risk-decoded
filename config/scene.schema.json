{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk Decoded scenes.json",
  "description": "Ordered scene plan produced from a script (FR-C2). One object per scene.",
  "type": "object",
  "required": [
    "episode",
    "scenes"
  ],
  "properties": {
    "episode": {
      "type": "string",
      "description": "episode id, e.g. ep01"
    },
    "generated_at": {
      "type": "string",
      "description": "excluded from determinism checks"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "shot",
          "narration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "shot": {
            "type": "string",
            "enum": [
              "QUBIT",
              "QUBIT+PANEL",
              "DIAGRAM",
              "SCENE"
            ]
          },
          "narration": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qubit_state": {
            "type": "string",
            "enum": [
              "idle",
              "talking",
              "point_left",
              "point_right",
              "aha",
              "worried",
              "thumbs_up",
              "spin",
              "twin",
              "ripple",
              "dizzy",
              "snap"
            ]
          },
          "mood": {
            "type": "string",
            "enum": [
              "calm",
              "caution",
              "threat"
            ]
          },
          "t_start": {
            "type": "number",
            "minimum": 0
          },
          "t_end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "timing_basis": {
      "type": "string",
      "description": "how t_start/t_end were derived (estimated vs voice timings)"
    }
  }
}
